# .env.example — secrets for the LiteLLM proxy (TEMPLATE). Copy to .env, fill values.
# Generate LITELLM_MASTER_KEY:  python -c "import secrets;print('sk-'+secrets.token_hex(16))"
LITELLM_MASTER_KEY=sk-REPLACE_WITH_32_RANDOM_HEX_CHARS
LITELLM_UI_USER=admin
LITELLM_UI_PASS=REPLACE_WITH_STRONG_PASSWORD
