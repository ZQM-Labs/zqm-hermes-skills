# Hermes environment secrets — paste values here as you obtain them.
# Changes take effect after /reset (chat) or restarting the CLI/gateway.
# Located at: ~/.hermes/.env  (NOT committed; local-only)

# --- Home Assistant (tools/homeassistant toolset) ---
# Long-lived access token: HA profile (bottom-left) -> Security -> Long-lived access tokens -> Create token.
# HASS_TOKEN=
# Optional if HA is not on http://localhost:8123:
# HASS_URL=http://homeassistant.local:8123

# --- xAI / X search (tools/x_search toolset) ---
# Get a key at https://x.ai/api
# XAI_API_KEY=
